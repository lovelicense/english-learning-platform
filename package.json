{
  "name": "english-learning-platform",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @elp/web dev",
    "dev:mobile": "pnpm --filter @elp/mobile dev",
    "dev:api": "pnpm --filter @elp/api start:dev",
    "dev:worker": "pnpm --filter @elp/worker dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @elp/api prisma generate",
    "db:migrate": "pnpm --filter @elp/api prisma migrate dev",
    "db:push": "pnpm --filter @elp/api prisma db push",
    "db:seed": "pnpm --filter @elp/api prisma db seed"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
