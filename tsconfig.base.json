{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@elp/shared": ["packages/shared/src"],
      "@elp/shared/*": ["packages/shared/src/*"],
      "@elp/domain": ["packages/domain/src"],
      "@elp/domain/*": ["packages/domain/src/*"],
      "@elp/ai": ["packages/ai/src"],
      "@elp/ai/*": ["packages/ai/src/*"]
    }
  }
}
