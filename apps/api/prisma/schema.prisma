generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordingStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}

enum RecordingAnalysisStatus {
  NOT_ANALYZED
  OK
  NEEDS_REVIEW
}

enum RecordingSource {
  WEB
  MOBILE
  MANUAL_UPLOAD
}

enum RecordingSessionStatus {
  CREATED
  UPLOADING
  UPLOADED
  QUEUED
  PROCESSING
  PROCESSED
  FAILED
  CANCELLED
}

enum RecordingPartStatus {
  PRESIGNED
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}

enum RecordingJobType {
  TRANSCRIBE_PART
  ANALYZE_SESSION
  GENERATE_EXPRESSION
  GENERATE_TTS
}

enum RecordingJobTargetType {
  RECORDING_SESSION
  RECORDING_PART
  RECORDING
  EXPRESSION
}

enum RecordingJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum RecordingJobPriority {
  HIGH
  NORMAL
  LOW
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  personProfiles PersonProfile[]
  recordings   Recording[]
  recordingSessions RecordingSession[]
  recordingJobs RecordingJob[]
  savedSentences SavedSentence[]
  expressions  Expression[]
  practiceLogs PracticeLog[]
}

model Recording {
  id                   String          @id @default(cuid())
  userId               String
  audioKey             String
  fileName             String
  status               RecordingStatus @default(UPLOADED)
  diarization          Boolean         @default(false)
  analysisSummary      String?
  analysisRelationship String?
  analysisSituation    String?
  analysisTone         String?
  analysisStatus       RecordingAnalysisStatus @default(NOT_ANALYZED)
  analysisStatusReason String?
  analysisUpdatedAt    DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  user                 User            @relation(fields: [userId], references: [id])
  utterances           Utterance[]
  participants         RecordingParticipant[]
  speakerProfiles      RecordingSpeakerProfile[]
  sourcePart           RecordingPart?  @relation("PartRecording")
}

model PersonProfile {
  id               String   @id @default(cuid())
  userId           String
  name             String
  roleLabel        String?
  relationshipToMe String?
  aliases          String?
  notes            String?
  isMe             Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])
  recordingParticipants RecordingParticipant[]
  recordingSpeakerProfiles RecordingSpeakerProfile[]
  savedSentenceParticipants SavedSentenceParticipant[]

  @@unique([userId, name])
}

model RecordingParticipant {
  id            String       @id @default(cuid())
  recordingId   String
  personProfileId String
  createdAt     DateTime     @default(now())
  recording     Recording    @relation(fields: [recordingId], references: [id])
  personProfile PersonProfile @relation(fields: [personProfileId], references: [id])

  @@unique([recordingId, personProfileId])
}

model RecordingSpeakerProfile {
  id            String       @id @default(cuid())
  recordingId   String
  speakerLabel  String
  personProfileId String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  recording     Recording    @relation(fields: [recordingId], references: [id])
  personProfile PersonProfile @relation(fields: [personProfileId], references: [id])

  @@unique([recordingId, speakerLabel])
}

model Utterance {
  id           String      @id @default(cuid())
  recordingId  String
  speakerLabel String
  koreanText   String
  contextNote  String?
  startMs      Int
  endMs        Int
  isMine       Boolean     @default(false)
  analysisIntent String?
  createdAt    DateTime    @default(now())
  recording    Recording   @relation(fields: [recordingId], references: [id])
  expressions  Expression[]
}

model Expression {
  id          String        @id @default(cuid())
  userId      String
  utteranceId String?
  savedSentenceId String?
  koreanText  String
  englishBase String
  englishEasy String
  englishNatural String
  note        String?
  userMemo    String?
  ttsKey      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id])
  utterance    Utterance?    @relation(fields: [utteranceId], references: [id])
  savedSentence SavedSentence? @relation(fields: [savedSentenceId], references: [id])
  practiceLogs PracticeLog[]
}

model SavedSentence {
  id              String       @id @default(cuid())
  userId          String
  koreanText      String
  contextNote     String?
  relationship    String?
  situation       String?
  tone            String?
  analysisSummary String?
  analysisIntent  String?
  analysisUpdatedAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id])
  participants    SavedSentenceParticipant[]
  expressions     Expression[]
}

model SavedSentenceParticipant {
  id             String        @id @default(cuid())
  savedSentenceId String
  personProfileId String
  createdAt      DateTime      @default(now())
  savedSentence  SavedSentence @relation(fields: [savedSentenceId], references: [id])
  personProfile  PersonProfile @relation(fields: [personProfileId], references: [id])

  @@unique([savedSentenceId, personProfileId])
}

model PracticeLog {
  id           String      @id @default(cuid())
  userId       String
  expressionId String
  target       String
  answer       String
  audioKey     String?
  mode         String?     
  testType     String?     
  promptKorean String?
  promptContext String?
  recognizedAnswer String?
  score        Int
  meaningScore Int?
  naturalnessScore Int?
  grammarScore Int?
  feedback     String
  strengthComment String?
  correctionComment String?
  suggestedAnswer String?
  suggestedAnswerAlt String?
  createdAt    DateTime    @default(now())
  user         User        @relation(fields: [userId], references: [id])
  expression   Expression  @relation(fields: [expressionId], references: [id])
}

model RecordingSession {
  id                String               @id @default(cuid())
  userId            String
  source            RecordingSource
  status            RecordingSessionStatus @default(CREATED)
  title             String?
  expectedPartCount Int?
  uploadedPartCount Int                  @default(0)
  totalDurationMs   Int?
  errorMessage      String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  completedAt       DateTime?
  user              User                 @relation(fields: [userId], references: [id])
  parts             RecordingPart[]
  jobs              RecordingJob[]
}

model RecordingPart {
  id           String              @id @default(cuid())
  sessionId    String
  recordingId  String?             @unique
  partNumber   Int
  audioKey     String
  fileName     String
  contentType  String
  durationMs   Int?
  sizeBytes    Int?
  status       RecordingPartStatus @default(PRESIGNED)
  errorMessage String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  session      RecordingSession    @relation(fields: [sessionId], references: [id])
  recording    Recording?          @relation("PartRecording", fields: [recordingId], references: [id])
  jobs         RecordingJob[]

  @@unique([sessionId, partNumber])
}

model RecordingJob {
  id           String               @id @default(cuid())
  userId       String?
  sessionId    String?
  partId       String?
  type         RecordingJobType
  targetType   RecordingJobTargetType
  targetId     String
  status       RecordingJobStatus   @default(QUEUED)
  priority     RecordingJobPriority @default(NORMAL)
  attempts     Int                  @default(0)
  maxAttempts  Int                  @default(3)
  errorMessage String?
  payload      Json?
  runAfter     DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  completedAt  DateTime?
  user         User?                @relation(fields: [userId], references: [id])
  session      RecordingSession?    @relation(fields: [sessionId], references: [id])
  part         RecordingPart?       @relation(fields: [partId], references: [id])

  @@index([status, priority, createdAt])
  @@index([sessionId, createdAt])
  @@index([partId, createdAt])
}
